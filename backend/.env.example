# ==========================================
# MediAlert Backend Environment Configuration
# ==========================================

# Port the backend server runs on
PORT=8000

# MongoDB Connection String & Database Name
MONGODB_URI=mongodb://localhost:27017
DB_NAME=medialert

# Clerk Authentication Keys (from https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Frontend URL & CORS Origins
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Google Calendar Integration (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/auth/google/callback

# Signs the Google OAuth `state` parameter (any long random string).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=replace_with_a_long_random_string

# Gemini AI Assistant API Key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Key for the Python AI evaluator's /api/v1/internal routes (24+ characters).
# Leave empty to disable those routes.
INTERNAL_API_KEY=

# Timezone used for "today", dose times and cron schedules (defaults to Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata

# Optional: Redis Cache (Leave empty or commented out if not running Redis locally)
REDIS_URL=
# REDIS_URL=redis://localhost:6379

# Optional: RabbitMQ Broker (Leave empty or commented out if not running RabbitMQ locally)
RABBITMQ_URL=
# RABBITMQ_URL=amqp://localhost:5672

